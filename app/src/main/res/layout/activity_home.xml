<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidAiIssues — single-page AI-rule fixture. Everything is on the HOME page so one
  scan of the launch screen catches both AI rules:

  1) image-in-text (WCAG 1.4.5): four images whose pixels contain readable text and which
     match no exception (not logos, icons, charts, or scanned documents). contentDescriptions
     are set deliberately — a label does NOT satisfy this rule, and having labels keeps the
     missing-label rules quiet so the scan stays focused on the AI findings.

  2) meaningful-reading-order (WCAG 1.3.2/2.4.3): three numbered steps stacked vertically,
     with accessibilityTraversal* forcing traversal Step 1 -> Step 3 -> Step 2. A cross-row
     scramble of explicitly numbered content demonstrably breaks logical flow, and matches
     none of the engine's intentional cases (not same-row, not a sticky CTA, not a modal,
     not a card grouping). The engine reports at most one reading-order issue per scan.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Issues"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- ============ image-in-text: 2x2 grid of text-bearing images ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ai_text_image_1"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/text_image_1"
            android:contentDescription="Promotional banner one" />

        <ImageView
            android:id="@+id/ai_text_image_2"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/text_image_2"
            android:contentDescription="Promotional banner two" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ai_text_image_3"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/text_image_3"
            android:contentDescription="Promotional banner three" />

        <ImageView
            android:id="@+id/ai_text_image_4"
            android:layout_width="0dp"
            android:layout_height="130dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/text_image_4"
            android:contentDescription="Promotional banner four" />
    </LinearLayout>

    <!-- ============ meaningful-reading-order: visually wrong semantic order ============
         Proven-detectable pattern (mirrors QA_Accessibility_App's Meaningful Sequence screen):
         on Android the accessibility dump follows visual position, so the violation must be a
         visually wrong top-to-bottom order - price above product name, input above its label,
         controls above the song they control. No traversal overrides. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEF2"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V-01: Price Before Name"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price rendered ABOVE the product name."
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ai_mro_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$79.99"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ai_mro_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wireless Headphones"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEF2"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V-02: Input Before Label"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text field rendered ABOVE its label."
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/ai_mro_email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter here..."
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/ai_mro_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEF2"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V-03: Controls Before Song"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Playback controls rendered ABOVE the song title/artist."
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ai_mro_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Prev"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/ai_mro_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Play"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/ai_mro_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Next" />
        </LinearLayout>

        <TextView
            android:id="@+id/ai_mro_song"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bohemian Rhapsody"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ai_mro_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queen"
            android:textSize="14sp" />
    </LinearLayout>

  </LinearLayout>
</ScrollView>
